#!/usr/bin/env bash
# FILE: tools/hooks/pre-commit — механические инварианты коммита (ADR-070; состав — ADR-066; фикс — ADR-074)
# Установка: ln -s ../../tools/hooks/pre-commit .git/hooks/pre-commit
set -euo pipefail
fail() { echo "PRE-COMMIT FAIL: $1" >&2; exit 1; }
staged() { git diff --cached --name-only --diff-filter=ACM; }

# ADR-074 §2: класс гомоглифов задан альтернацией целых символов, не bracket-выражением.
# Под байтовой семантикой (локаль C или несуществующая) bracket-выражение над многобайтными
# символами распадается на множество БАЙТОВ, и ведущий байт 0xD0 совпадает с любой кириллицей.
CYR='(М|С|Е|А|Р|О|Т|Н|К|В|Х)'
ID_ROW='(Q-[0-9]+|[A-Z0-9-]+)'

# 1. ADR-054: первая строка нумерованного/подчёркнутого дока = имя файла
for f in $(staged | grep -E '^(_[A-Z]|[0-9]{2}_).*\.md$' || true); do
  blob=$(git show ":$f")            # ADR-074 §1: без пайпа в head, иначе SIGPIPE на файле больше буфера пайпа
  first=${blob%%$'\n'*}
  base=$(basename "$f" .md)
  printf '%s\n' "$first" | grep -qE "^# (FILE: )?_?${base}|^# [0-9]{2} ·" \
    || fail "$f: первая строка не соответствует имени файла (ADR-054): '$first'"
done

# 2. ADR-041: кириллические гомоглифы внутри ID (ADR-/Q-/B-/RQ-/E1-/M-P)
added=$(git diff --cached -U0 | grep -E '^\+' || true)   # ADR-074 §1: подсчёт вместо -q, вход дочитывается до EOF
hits=$(printf '%s\n' "$added" | grep -nE "(ADR|RQ|E1|Q|B)[-–][0-9]*${CYR}|${CYR}(DR-|Q-|-P)" || true)
if [ -n "$hits" ]; then
  printf '%s\n' "$hits" >&2                              # ADR-044: печатать совпавшие строки, не только вердикт
  fail "кириллица внутри идентификатора (ADR-041)"
fi

# 3. ADR-064: append ADR в 06 => строка в 06_INDEX тем же коммитом
if staged | grep -q '^06_DECISIONS_LOG.md$'; then
  new_adr=$(git diff --cached -U0 -- 06_DECISIONS_LOG.md | grep -oE '^\+## (ADR-[0-9]+)' | grep -oE 'ADR-[0-9]+' || true)
  for a in $new_adr; do
    staged | grep -q '^06_INDEX.md$' || fail "$a добавлен в 06, но 06_INDEX.md не в коммите (ADR-064)"
    git show :06_INDEX.md | grep -qF "$a" || fail "$a отсутствует в 06_INDEX.md (ADR-064)"
  done
fi

# 4. ADR-064: строка с ID ИСЧЕЗЛА из 07_STATE => 07_ARCHIVE в том же коммите.
# ADR-074 §7: сравниваются множества ID удалённых и добавленных строк. Переформулировка строки
# (ID есть и там, и там) больше не срабатывает: это был документированный ложный позитив,
# вынуждавший --no-verify на каждой правке существующей строки.
d4=$(git diff --cached -U0 -- 07_STATE.md || true)
gone_ids=$(comm -23 \
  <(printf '%s\n' "$d4" | grep -oE "^\-\| ${ID_ROW} \|" | sed -E 's/^\-\| //; s/ \|$//' | sort -u) \
  <(printf '%s\n' "$d4" | grep -oE "^\+\| ${ID_ROW} \|" | sed -E 's/^\+\| //; s/ \|$//' | sort -u) || true)
if [ -n "$gone_ids" ]; then
  staged | grep -q '^07_ARCHIVE.md$' \
    || fail "строки исчезли из 07_STATE, 07_ARCHIVE.md не в коммите (ADR-064): $(printf '%s' "$gone_ids" | tr '\n' ' ')"
fi

# 5. Правка 07_STATE => обновлён updated_at
if staged | grep -q '^07_STATE.md$'; then
  n=$(git diff --cached -- 07_STATE.md | grep -cE '^\+\*\*updated_at:\*\*' || true)
  [ "$n" -gt 0 ] || fail "07_STATE.md правится без обновления updated_at"
fi
echo "pre-commit: инварианты ADR-054/041/064 пройдены"
