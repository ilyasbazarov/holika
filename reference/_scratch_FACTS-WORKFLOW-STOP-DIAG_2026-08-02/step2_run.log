    "sourceContents": "main:\n  params: [args]\n  steps:\n    - init:\n        assign:\n          - run_id: ${sys.now()}\n          - cf_dim:       \"https://cf-dim-xw5u2boozq-de.a.run.app\"\n          - cf_fx:        \"https://cf-fx-xw5u2boozq-de.a.run.app\"\n          - cf_facts:     \"https://cf-facts-xw5u2boozq-de.a.run.app\"\n          - cf_dq:        \"https://cf-dq-xw5u2boozq-de.a.run.app\"\n    - step_dim:\n        try:\n          call: http.post\n          args:\n            url: ${cf_dim}\n            auth:\n              type: OIDC\n            body:\n              run_id: ${run_id}\n            timeout: 540\n          result: dim_result\n        except:\n          as: e\n          steps:\n            - log_dim_error:\n                call: sys.log\n                args:\n                  text: ${\"[HOURLY] step_dim FAILED run_id=\" + run_id + \" error=\" + json.encode_to_string(e)}\n                  severity: ERROR\n            - raise_dim:\n                raise: ${e}\n    - step_fx:\n        try:\n          call: http.post\n          args:\n            url: ${cf_fx}\n            auth:\n              type: OIDC\n            body:\n              run_id: ${run_id}\n            timeout: 180\n          result: fx_result\n        except:\n          as: e\n          steps:\n            - log_fx_error:\n                call: sys.log\n                args:\n                  text: ${\"[HOURLY] step_fx FAILED run_id=\" + run_id + \" error=\" + json.encode_to_string(e)}\n                  severity: ERROR\n            - raise_fx:\n                raise: ${e}\n    - step_facts:\n        try:\n          call: http.post\n          args:\n            url: ${cf_facts}\n            auth:\n              type: OIDC\n            body:\n              run_id: ${run_id}\n              mode: \"hourly\"\n            timeout: 600\n          result: facts_result\n        except:\n          as: e\n          steps:\n            - log_facts_error:\n                call: sys.log\n                args:\n                  text: ${\"[HOURLY] step_facts FAILED run_id=\" + run_id + \" error=\" + json.encode_to_string(e)}\n                  severity: ERROR\n            - raise_facts:\n                raise: ${e}\n    - step_dq:\n        try:\n          call: http.post\n          args:\n            url: ${cf_dq}\n            auth:\n              type: OIDC\n            body:\n              run_id: ${run_id}\n            timeout: 120\n          result: dq_result\n        except:\n          as: e\n          steps:\n            - log_dq_error:\n                call: sys.log\n                args:\n                  text: ${\"[HOURLY] step_dq CRASHED run_id=\" + run_id + \" error=\" + json.encode_to_string(e)}\n                  severity: CRITICAL\n            - raise_dq:\n                raise: ${e}\n    - parse_dq_result:\n        assign:\n          - dq_parsed: ${json.decode(dq_result.body)}\n    - check_dq:\n        switch:\n          - condition: ${not(dq_parsed.passed)}\n            steps:\n              - log_dq_failed:\n                  call: sys.log\n                  args:\n                    text: ${\"[HOURLY] DQ Gate FAILED run_id=\" + run_id + \" details=\" + json.encode_to_string(dq_parsed)}\n                    severity: CRITICAL\n              - raise_dq_failed:\n                  raise: \"DQ Gate failed — promote blocked\"\n    - step_promote:\n        try:\n          call: http.post\n          args:\n            url: ${cf_facts}\n            auth:\n              type: OIDC\n            body:\n              run_id: ${run_id}\n              mode: \"promote\"\n              window_days: 7\n            timeout: 300\n          result: promote_result\n        except:\n          as: e\n          steps:\n            - log_promote_error:\n                call: sys.log\n                args:\n                  text: ${\"[HOURLY] step_promote FAILED run_id=\" + run_id + \" error=\" + json.encode_to_string(e)}\n                  severity: ERROR\n            - raise_promote:\n                raise: ${e}\n    - step_purchases:\n        try:\n          call: http.post\n          args:\n            url: ${cf_facts}\n            auth:\n              type: OIDC\n            body:\n              run_id: ${run_id}\n              mode: \"purchases\"\n              window_days: 90\n            timeout: 300\n          result: purchases_result\n        except:\n          as: e\n          steps:\n            - log_purchases_warning:\n                call: sys.log\n                args:\n                  text: ${\"[HOURLY] step_purchases FAILED (non-blocking) run_id=\" + run_id + \" error=\" + json.encode_to_string(e)}\n                  severity: WARNING\n    - done:\n        steps:\n          - log_success:\n              call: sys.log\n              args:\n                text: ${\"[HOURLY] Pipeline COMPLETED run_id=\" + run_id}\n                severity: INFO\n          - return_result:\n              return: ${promote_result.body}\n",
    "state": "ACTIVE",
