=== Запрос 1а: MIN/MAX(_loaded_at) + распределение по суткам ===
--- SQL (minmax) ---
SELECT MIN(_loaded_at) AS min_loaded_at, MAX(_loaded_at) AS max_loaded_at
FROM `msklad-bi-prod.core.fact_sales_profit`
WHERE transaction_date BETWEEN "2026-05-01" AND "2026-05-31"
[{"max_loaded_at":"2026-07-19 01:08:45","min_loaded_at":"2026-05-14 03:01:59"}]
--- SQL (distribution by loaded_date) ---
SELECT DATE(_loaded_at) AS loaded_date, COUNT(*) AS n_rows
FROM `msklad-bi-prod.core.fact_sales_profit`
WHERE transaction_date BETWEEN "2026-05-01" AND "2026-05-31"
GROUP BY loaded_date
ORDER BY loaded_date
